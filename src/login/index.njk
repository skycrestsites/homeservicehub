---
layout: layouts/base.njk
title: "Log in | Home Service Hub"
description: "Log in or create your Home Service Hub account."
pageScript: account
noindex: true
---
<section class="auth-page">
  <div class="container">
    <div class="auth-card">
      <h1 class="h3" data-auth-title>Log in</h1>
      <p class="auth-sub" data-auth-sub>One account for the free course, the community and Premium when it opens.</p>

      <button class="btn btn-google btn-lg" type="button" id="google-btn" data-only="login signup">
        <svg class="g-logo" viewBox="0 0 48 48" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 13 4 4 13 4 24s9 20 20 20 20-9 20-20c0-1.3-.1-2.4-.4-3.5z"/><path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2c-2 1.5-4.5 2.4-7.2 2.4-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/></svg>
        Continue with Google
      </button>

      <div class="auth-or" data-only="login signup"><span>or with email</span></div>

      <form class="auth-form" id="auth-form" data-mode="login" novalidate>
        <div class="field" data-only="signup" hidden>
          <label for="auth-name">Name</label>
          <input id="auth-name" name="name" type="text" autocomplete="name" maxlength="80">
        </div>
        <div class="field">
          <label for="auth-email">Email</label>
          <input id="auth-email" name="email" type="email" autocomplete="email" maxlength="254" required>
        </div>
        <div class="field" data-only="login signup">
          <div class="field-top">
            <label for="auth-password">Password</label>
            <button class="link-btn" type="button" data-mode-to="reset" data-only="login">Forgot password?</button>
          </div>
          <input id="auth-password" name="password" type="password" autocomplete="current-password" minlength="8" maxlength="128" required>
          <small class="field-hint" data-only="signup" hidden>At least 8 characters.</small>
        </div>
        <button class="btn btn-primary btn-lg" type="submit" id="auth-submit">Log in</button>
        <p class="auth-msg" role="status" aria-live="polite"></p>
      </form>

      <p class="auth-switch">
        <span data-only="login">New here? <button class="link-btn" type="button" data-mode-to="signup">Create an account</button></span>
        <span data-only="signup" hidden>Already have an account? <button class="link-btn" type="button" data-mode-to="login">Log in</button></span>
        <span data-only="reset" hidden>Remembered it? <button class="link-btn" type="button" data-mode-to="login">Back to log in</button></span>
      </p>
      <p class="fine">By continuing you agree to the <a href="/terms/">Terms</a> and <a href="/privacy/">Privacy Policy</a>.</p>
    </div>
  </div>
</section>
