{% import "components/ui.njk" as ui with context %}

<section class="page-hero center">
  <div class="container">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a>{% icon "chevron-right" %}<span>Courses</span></nav>
    <span class="eyebrow">Courses</span>
