{
  "name": "homeservicehub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Home Service Hub website (learnhomeservices.com)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "eleventy --serve",
    "build": "eleventy",
    "build:prod": "cross-env ELEVENTY_ENV=production eleventy",
    "lint": "eslint . && stylelint \"src/assets/css/**/*.css\"",
    "validate": "html-validate \"_site/**/*.html\"",
    "check": "npm run build:prod && npm run lint && npm run validate",
    "deploy": "npm run build:prod && firebase deploy --only hosting"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.7",
    "@eslint/js": "9.39.5",
    "browserslist": "4.29.4",
    "cross-env": "10.1.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "globals": "17.13.0",
    "html-validate": "10.11.3",
    "lightningcss": "1.33.0",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0"
  },
  "dependencies": {
    "firebase": "13.1.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6"
  }
}
