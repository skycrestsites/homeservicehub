rules_version = '2';

// The only thing the public site can do is add an email to a waitlist.
// Nobody can read, change or delete entries from the browser. Exports run with admin access.
service cloud.firestore {
  match /databases/{database}/documents {

    match /waitlist/{id} {
      allow create: if id.matches('^[a-f0-9]{64}$') && isValidSignup(request.resource.data);
      allow read, update, delete: if false;
    }

    // Premium lessons. Only this account can read them, and nobody can change them from the browser.
    match /premiumLessons/{id} {
      allow read: if request.auth != null
        && request.auth.token.email == "netspirestudios@gmail.com"
        && request.auth.token.email_verified == true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    function isValidSignup(d) {
      return d.keys().hasOnly(['email', 'list', 'createdAt'])
        && d.keys().hasAll(['email', 'list', 'createdAt'])
        && d.email is string
        && d.email.size() <= 254
        && d.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$')
        && d.email == d.email.lower()
        && d.list in ['cleaning-premium', 'junk-removal', 'landscaping', 'scaling-beyond']
        && d.createdAt == request.time;
    }
  }
}
